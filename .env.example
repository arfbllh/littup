# ── Application ─────────────────────────────────────────────────────────────
ENV=development                         # development | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────────────────────
# Primary connection (used by the app via pgbouncer)
DATABASE_URL=postgresql+asyncpg://littup:littup@localhost:5432/littup
# Direct connection (used by Alembic migrations — bypasses pgbouncer)
DATABASE_URL_DIRECT=postgresql+asyncpg://littup:littup@localhost:5432/littup
# Test database (used by pytest integration tests)
TEST_DATABASE_URL=postgresql+asyncpg://littup:littup@localhost:5432/littup_test

# ── pgbouncer ────────────────────────────────────────────────────────────────
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=5432

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY_OCR=2               # asyncio.Semaphore N for OCR jobs
WORKER_CONCURRENCY_EMBEDDING=4         # asyncio.Semaphore N for embedding jobs
WORKER_CONCURRENCY_DEFAULT=2
WORKER_HEARTBEAT_INTERVAL=10           # seconds between heartbeat updates
JOB_STALE_TIMEOUT=120                  # seconds before a running job is reclaimed
JOB_QUEUE_MAX_PENDING=100              # 429 threshold (Invariant #3)

# ── LLM Router ───────────────────────────────────────────────────────────────
# Leave any key blank to disable that provider; the router skips entries whose
# required env is absent and falls over to the next in the tier. If every
# provider in a tier is disabled, calls in that tier raise LLMUnavailableError.
ANTHROPIC_API_KEY=                     # sk-ant-...
OPENAI_API_KEY=                        # sk-...
GEMINI_API_KEY=                        # AI...

# Local Ollama daemon. Point at the daemon root — no /v1 suffix (the provider
# strips it for legacy compatibility, but the canonical form is just the host).
# Inside docker-compose, set this to http://host.docker.internal:11434 so the
# api/worker containers can reach the host's Ollama daemon.
OLLAMA_BASE_URL=http://localhost:11434

LLM_HOURLY_BUDGET_USD=5.00             # global rolling-window spend cap (Invariant #6)
MAX_VLM_PAGES_PER_DOC=20               # per-document VLM page cap (Invariant #6)

# Optional: log full LLM prompts to llm_log.llm_requests for debugging.
# Off by default — prompts can leak PII.
LLM_LOG_PROMPTS=false
LLM_LOG_PROMPTS_MAX_CHARS=4000

# ── Embeddings & rerank ──────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDER_PROVIDER=bge                  # "bge" | "openai"

# HuggingFace token — only needed for gated/private models. Picked up by
# huggingface_hub from the environment.
HF_TOKEN=

# Torch device — "cpu" | "mps" | "cuda". MPS on Apple Silicon caps the unified
# memory pool at ~9 GB; if you OOM on M-series, fall back to "cpu".
TORCH_DEVICE=cpu

# ── OCR ──────────────────────────────────────────────────────────────────────
OCR_CONFIG_PATH=config/ocr.yaml
OCR_USE_GPU=false
# Skip PaddleOCR's HF connectivity probe on every model load.
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# ── Retrieval ────────────────────────────────────────────────────────────────
HNSW_EF_SEARCH=100
RETRIEVAL_WORK_MEM=64MB
RETRIEVAL_STATEMENT_TIMEOUT=5s
MAX_CHUNKS_PER_DOC_PER_QUERY=3

# ── Storage ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800              # 50 MB
UPLOAD_DIR=data/uploads
PAGE_IMAGE_DIR=data/page_images
